# Local development only. Do not prefix secrets with VITE_.
# SMTP and auth services are NOT enabled by this file or by building the site.
AUTH_MODE=smtp
AUTH_BASE_URL=https://reporadars.com
AUTH_PORT=4320
# Only on first explicit initialization of a new database, not normal startup:
# AUTH_MIGRATE=yes
# Absolute paths outside this checkout; directories 0700, files 0600.
AUTH_SECRET_FILE=/absolute/private/reporadars/auth-secret
AUTH_DATABASE_PATH=/absolute/private/reporadars/auth.sqlite
MAIL_CONFIG_FILE=/absolute/private/reporadars/smtp.json
# Optional local preview proxy. Only loopback HTTP origins are accepted.
# AUTH_PREVIEW_API_ORIGIN=http://127.0.0.1:4320
