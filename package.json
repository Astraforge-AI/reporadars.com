{
  "name": "reporadars-com",
  "version": "0.0.0",
  "private": true,
  "description": "A curated AI skills catalog with collections, transparent sources, and a local workspace.",
  "homepage": "https://reporadars.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astraforge-AI/reporadars.com.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "auth:dev": "node server/start.mjs",
    "test:auth": "node --test tests/auth/*.test.mjs",
    "dev": "node scripts/next-dev.mjs",
    "build": "next build --webpack && node scripts/next-export.mjs && node scripts/prepare-sites-build.mjs && node scripts/homepage-build.mjs",
    "preview": "node scripts/homepage-preview.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "verify": "make verify",
    "build:runtime": "node scripts/runtime-build.mjs",
    "test:runtime": "NODE_ENV=production node --test tests/runtime-catalog.test.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/six-caps": "^5.3.0",
    "@fontsource/yanone-kaffeesatz": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.7.3",
    "better-sqlite3": "12.11.1",
    "next": "^16.3.8",
    "nodemailer": "10.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4"
  }
}
