[Unit]
Description=Reporadars origin, intake, disk and complete backup monitor
After=reporadars.service
[Service]
Type=oneshot
User=root
Group=reporadars
WorkingDirectory=/opt/reporadars/current
ExecStart=/usr/bin/node ops/reporadars/monitor.mjs
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reporadars-monitor /var/lib/reporadars-intake/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=30
MemoryMax=256M
